# sign.smartroofing.ai — Documenso configuration for the SmartRoofing AI fork.
#
# Copy to .env beside compose.yml and fill in every <...>. Lines marked
# SECRET must come from your secret store; everything else is safe to commit
# in a per-environment copy if you prefer.
#
# Generate keys:
#   NEXTAUTH_SECRET, encryption keys:   openssl rand -base64 32   (run three times)
#   Signing certificate:                scripts/generate-signing-certificate.sh --org "SmartRoofing AI" ...

# ── Edge ────────────────────────────────────────────────────────────────────
SIGN_HOST="sign.smartroofing.ai"
ACME_EMAIL="ops@smartroofing.ai"

# ── Database (compose wires the URL; only the password is needed) ───────────
POSTGRES_USER="documenso"
POSTGRES_PASSWORD="<SECRET>"
POSTGRES_DB="documenso"

# ── Application identity ────────────────────────────────────────────────────
NEXT_PUBLIC_WEBAPP_URL="https://sign.smartroofing.ai"
NEXT_PUBLIC_SUPPORT_EMAIL="support@smartroofing.ai"
NEXTAUTH_SECRET="<SECRET>"
NEXT_PRIVATE_ENCRYPTION_KEY="<SECRET>"
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY="<SECRET>"

# ── Access policy: a private contractor instance ────────────────────────────
# Staff accounts are created by an admin or via SSO; homeowners never need an
# account to sign. Public signup is off and any OIDC/SSO signups are limited
# to the company domain.
NEXT_PUBLIC_DISABLE_SIGNUP="true"
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS="smartroofing.ai"
NEXT_PUBLIC_DISABLE_GOOGLE_SIGNIN="true"
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNIN="true"
# Fill these to sign staff in through your identity provider, then set
# NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNIN="true".
NEXT_PRIVATE_OIDC_WELL_KNOWN=""
NEXT_PRIVATE_OIDC_CLIENT_ID=""
NEXT_PRIVATE_OIDC_CLIENT_SECRET=""
NEXT_PRIVATE_OIDC_PROVIDER_LABEL="SmartRoofing SSO"

# ── Features / billing ──────────────────────────────────────────────────────
# Self-hosted: billing off unlocks every plan capability for the organisation.
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=""
DOCUMENSO_DISABLE_TELEMETRY="true"
# Roofing contracts with photos exceed the 5 MB default.
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT="25"

# ── Storage ─────────────────────────────────────────────────────────────────
# database keeps PDFs in Postgres (simple, backed up with the DB). Switch to
# s3 with a bucket when volume grows.
NEXT_PUBLIC_UPLOAD_TRANSPORT="database"

# ── Jobs ────────────────────────────────────────────────────────────────────
NEXT_PRIVATE_JOBS_PROVIDER="local"

# ── Email ───────────────────────────────────────────────────────────────────
# Resend with the smartroofing.ai domain verified (SPF, DKIM, DMARC). The
# fork can also register per-organisation sending domains through Resend from
# Admin → Email domains.
NEXT_PRIVATE_SMTP_TRANSPORT="resend"
NEXT_PRIVATE_RESEND_API_KEY="<SECRET>"
NEXT_PRIVATE_SMTP_FROM_NAME="SmartRoofing AI"
NEXT_PRIVATE_SMTP_FROM_ADDRESS="no-reply@smartroofing.ai"

# ── Document signing (PAdES, timestamped) ───────────────────────────────────
NEXT_PRIVATE_SIGNING_TRANSPORT="local"
# Host path to the PKCS#12 bundle; compose mounts it at /opt/documenso/cert.p12.
SIGNING_CERT_PATH="/opt/smartroofing/secrets/smartroofing-ai-signing.p12"
NEXT_PRIVATE_SIGNING_PASSPHRASE="<SECRET>"
NEXT_PRIVATE_SIGNING_TIMESTAMP_AUTHORITY="http://timestamp.digicert.com,http://timestamp.sectigo.com"
NEXT_PRIVATE_SIGNING_REASON="Signed by SmartRoofing AI via Documenso"
NEXT_PUBLIC_SIGNING_CONTACT_INFO="contracts@smartroofing.ai"

# ── Integrations ────────────────────────────────────────────────────────────
# Hosts your webhook receivers live on if they resolve to private addresses
# (comma separated). Leave empty in production.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=""
